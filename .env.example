# Server Binding (Runs on a random port for security; reverse-proxied externally)
HOST=0.0.0.0
PORT=48921

# Security & Session Secret Key (Generated automatically during install)
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_immediately

# Virtualizor Node API Settings (Localhost on Mother Server)
VIRTUALIZOR_IP=127.0.0.1
VIRTUALIZOR_PORT=4085
VIRTUALIZOR_API_KEY=your_virtualizor_api_key_here
VIRTUALIZOR_API_PASS=your_virtualizor_api_password_here

# Traffic Watcher Settings
POLL_INTERVAL_MINUTES=5
ROLLOVER_WINDOW_START_DAY=27
ROLLOVER_WINDOW_END_DAY=5
